DB_URL=jdbc:postgresql://localhost:5432/dental_clinic
DB_USERNAME=postgres
DB_PASSWORD=change-me
JWT_SECRET=replace-with-base64-encoded-32-byte-secret
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
ADMIN_SESSION_ABSOLUTE_LIFETIME=8h
ADMIN_SESSION_IDLE_TIMEOUT=15m
DOCTOR_SESSION_ABSOLUTE_LIFETIME=12h
DOCTOR_SESSION_IDLE_TIMEOUT=20m
STAFF_SESSION_ABSOLUTE_LIFETIME=12h
STAFF_SESSION_IDLE_TIMEOUT=20m
PATIENT_SESSION_ABSOLUTE_LIFETIME=7d
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
AUTH_COOKIE_DOMAIN=
SPRING_PROFILES_ACTIVE=development
FLYWAY_ENABLED=true
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=30000
DB_VALIDATION_TIMEOUT_MS=5000
SERVER_PORT=8081
CLINIC_TIMEZONE=Asia/Ho_Chi_Minh
CANCELLATION_CUTOFF_MINUTES=90
RESCHEDULE_CUTOFF_MINUTES=90
NO_SHOW_GRACE_MINUTES=15
DELAY_WARNING_MINUTES=30
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
SERVICE_IMAGE_STORAGE_DIRECTORY=uploads/service-images
SERVICE_IMAGE_MAX_FILE_SIZE_BYTES=5242880
SERVICE_IMAGE_MAX_FILE_SIZE=5MB
SERVICE_IMAGE_MAX_REQUEST_SIZE=6MB
OPENAPI_ENABLED=true
SWAGGER_UI_ENABLED=true

# Gemini foundation. Keep disabled until a newly generated key is configured.
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=768
GEMINI_CHAT_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_THINKING_BUDGET=256
GEMINI_REQUEST_TIMEOUT=60s
AI_STREAMING_TIMEOUT=75s
GEMINI_RETRY_MAX_ATTEMPTS=2
GEMINI_RETRY_INITIAL_DELAY=500ms
GEMINI_RETRY_MAX_DELAY=4s
KNOWLEDGE_BASE_DIRECTORY=../knowledge-base
KNOWLEDGE_BASE_MAX_FILE_SIZE_BYTES=5242880
AI_RAG_SYNC_CRON=0 */15 * * * *
AI_RAG_SYNC_LOCK_TIMEOUT=30m
AI_RAG_SYNC_BATCH_SIZE=30
AI_RAG_SYNC_BATCH_DELAY=21s
AI_RAG_DEFAULT_TOP_K=3
AI_RAG_MAX_TOP_K=20
AI_RAG_SIMILARITY_THRESHOLD=0.55
